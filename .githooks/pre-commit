#!/bin/sh
# Auto-formats staged Go files with the formatters in .golangci.yml
# (the same as `task fmt`) before each commit, then re-stages the
# formatted result so the commit includes clean code.
# Installed via `task hooks:install` (sets core.hooksPath to .githooks).

set -e

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ -z "$files" ]; then
    exit 0
fi

echo "$files" | xargs go tool golangci-lint fmt
echo "$files" | xargs git add
