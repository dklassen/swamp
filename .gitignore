/assets/
.direnv/
/PROFILE_REFERENCE.md

*.bak
*.bak-wal
*.bak-shm

# The central log (SWAMP_LOG_PATH, by default next to the database).
*.log

# Claude Code's per-user state: local settings (permission allowlists,
# which can embed paths, hosts and tokens), scratch files and worktrees.
# skills/ stays tracked: it's how Claude Code finds the repo's skills.
/.claude/*
!/.claude/skills/

# The user's own tracked companies: real employer names stay out of this
# public repo. See seed/data/companies.example.yaml for the format.
seed/data/companies.yaml
